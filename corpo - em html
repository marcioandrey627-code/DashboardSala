
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard | Monitoramento da Sala</title>
  <link rel="stylesheet" href="visual.css">
  <script src="app.js" defer></script>
</head>
<body>

<div class="layout">

  <!-- CONFIGURAÇÕES -->
  <aside class="sidebar">
    <h2>⚙️ Configurações</h2>
    <p class="legenda">
      Ajuste as regras da automação sem mexer no código.
    </p>

    <label for="temp-alta">
      Temperatura para ligar o ar (°C):
      <b id="temp-alta-valor">28</b>
    </label>
    <input type="range" id="temp-alta"
           min="20" max="32" value="28">

    <label for="lux-baixa">
      Luminosidade para ligar a luz (%):
      <b id="lux-baixa-valor">40</b>
    </label>
    <input type="range" id="lux-baixa"
           min="10" max="80" value="40">

    <hr>

    <label class="linha" for="auto-refresh">
      <input type="checkbox" id="auto-refresh">
      Atualização automática
    </label>

    <label for="intervalo">
      Intervalo (segundos):
      <b id="intervalo-valor">5</b>
    </label>
    <input type="range" id="intervalo"
           min="2" max="30" value="5" disabled>
  </aside>

  <!-- DASHBOARD -->
  <main class="conteudo">

    <!-- BANNER -->
    <header class="banner">
      <div>
        <div class="titulo">🏫 DASHBOARD TESTE</div>
        <div class="subtitulo">
          Monitoramento da sala • Dados simulados
        </div>
      </div>

      <div class="pills">
        <span class="status" id="banner-status"></span>
        <span class="status" id="banner-modo"></span>
        <span class="status" id="banner-hora"></span>
      </div>
    </header>

    <!-- SENSORES -->
    <section class="metricas">

      <div class="card metrica">
        <div class="rotulo">🌡️ Temperatura</div>
        <div class="valor" id="m-temp">--</div>
        <div class="delta" id="m-temp-delta"></div>
      </div>

      <div class="card metrica">
        <div class="rotulo">💧 Umidade</div>
        <div class="valor" id="m-umid">--</div>
      </div>

      <div class="card metrica">
        <div class="rotulo">💡 Luminosidade</div>
        <div class="valor" id="m-lux">--</div>
      </div>

      <div class="card metrica">
        <div class="rotulo">👥 Presença</div>
        <div class="valor" id="m-presenca">--</div>
      </div>

    </section>

    <button class="btn" id="btn-atualizar">
      🔄 Atualizar agora
    </button>

    <div id="alertas"></div>

    <!-- NAVEGAÇÃO -->
    <nav class="abas" aria-label="Seções do dashboard">
      <button class="aba-btn ativa" data-aba="sensores">
        📈 Sensores
      </button>
      <button class="aba-btn" data-aba="controles">
        🎛️ Controles
      </button>
      <button class="aba-btn" data-aba="verificacao">
        👥 Verificação
      </button>
    </nav>

    <!-- ABA SENSORES -->
    <section class="aba ativa" id="aba-sensores">
      <h3>Histórico de sensores</h3>

      <label for="sensor-grafico">Sensor</label>

      <select id="sensor-grafico">
        <option value="temperatura">Temperatura</option>
        <option value="umidade">Umidade</option>
        <option value="luminosidade">Luminosidade</option>
      </select>

      <canvas class="grafico" id="grafico-sensor"></canvas>

      <div class="linha-botoes">
        <button class="btn" id="btn-baixar">
          ⬇️ Baixar histórico (CSV)
        </button>

        <button class="btn" id="btn-limpar">
          🗑️ Limpar histórico
        </button>
      </div>
    </section>

    <!-- ABA CONTROLES -->
    <section class="aba" id="aba-controles">
      <h3>Controles da sala</h3>

      <div class="linha-botoes">
        <label class="linha" for="modo-auto">
          <input type="checkbox" id="modo-auto">
          🤖 Modo automático
        </label>

        <button class="btn primario" id="btn-desligar-tudo">
          ⏻ Desligar tudo (sem aula)
        </button>
      </div>

      <div class="duas-colunas">

        <div class="card">
          <h3>❄️ Ar-condicionado</h3>
          <span class="pill off" id="pill-ar"></span>
          <div>
            <button class="btn" id="btn-ar">
              Ligar/Desligar ar
            </button>
          </div>
        </div>

        <div class="card">
          <h3>💡 Luz</h3>
          <span class="pill off" id="pill-luz"></span>
          <div>
            <button class="btn" id="btn-luz">
              Ligar/Desligar luz
            </button>
          </div>
        </div>

      </div>

      <h4>📋 Últimos eventos</h4>
      <div id="lista-eventos"></div>
    </section>

    <!-- ABA VERIFICAÇÃO -->
    <section class="aba" id="aba-verificacao">
      <h3>Verificação de Pessoas</h3>

      <div class="card metrica metrica-pessoas">
        <div class="rotulo">👥 Pessoas nesta sala</div>
        <div class="valor" id="m-pessoas">--</div>
        <div class="delta" id="m-pessoas-delta"></div>
      </div>

      <canvas class="grafico" id="grafico-pessoas"></canvas>
    </section>

  </main>
</div>

<!-- CONTROLE DE VOZ -->
<section id="voz-widget" class="voz-widget"
         aria-label="Comando de voz">

  <div class="voz-cabecalho">

    <button id="btn-voz" type="button"
            aria-pressed="false">
      🎙️ Iniciar voz
    </button>

    <span id="voz-indicador"
          class="voz-indicador"
          aria-hidden="true"></span>

    <span id="voz-status" aria-live="polite">
      Microfone desligado
    </span>

  </div>

  <div class="voz-transcricao">
    <span>Transcrição:</span>
    <output id="voz-texto" aria-live="polite">
      Aguardando fala…
    </output>
  </div>

</section>

</body>
</html>
